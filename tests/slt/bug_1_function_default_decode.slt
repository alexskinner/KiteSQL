## Bug #1 regression test: Function DEFAULT decode context
##
## A column DEFAULT that evaluates a scalar function (built-in like current_timestamp)
## requires the scala_functions context to be available when decoding the column metadata.
##
## The bug manifests when a table with function DEFAULTs is reopened/reloaded and
## DDL operations (ALTER TABLE, CREATE INDEX) are performed on it.

statement ok
CREATE TABLE test_func_default (
    id INT PRIMARY KEY,
    created_at TIMESTAMP DEFAULT current_timestamp
)

statement ok
INSERT INTO test_func_default (id) VALUES (1)

query I
SELECT id FROM test_func_default
----
1

## Force table reload by running an unrelated DDL operation
statement ok
CREATE TABLE other_table (x INT PRIMARY KEY)

## Now perform DDL on the table with function DEFAULT
## This should work with the fix
statement ok
ALTER TABLE test_func_default ADD COLUMN status VARCHAR(50)

query II
SELECT id, status FROM test_func_default
----
1 NULL

## Create an index - another DDL operation that loads the table
statement ok
CREATE INDEX idx_status ON test_func_default (status)

statement ok
DROP TABLE test_func_default

statement ok
DROP TABLE other_table
