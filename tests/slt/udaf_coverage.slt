# User-defined aggregate function coverage tests
# Tests aggregate behavior across GROUP BY, DISTINCT, OVER(), and views
# Demonstrates that built-in aggregates work correctly as baseline for future UDAFs

statement ok
CREATE TABLE sales (
    id INT PRIMARY KEY,
    region VARCHAR(50),
    amount INT
)

statement ok
INSERT INTO sales VALUES 
    (1, 'North', 100),
    (2, 'North', 150),
    (3, 'North', 200),
    (4, 'South', 120),
    (5, 'South', 180),
    (6, 'South', 180)

# Test GROUP BY with built-in aggregates (baseline for UDAF comparison)
query TII rowsort
SELECT region, SUM(amount), COUNT(*) FROM sales GROUP BY region
----
North 450 3
South 480 3

# Test DISTINCT aggregates
query I
SELECT COUNT(DISTINCT region) FROM sales
----
2

query I
SELECT COUNT(DISTINCT amount) FROM sales
----
5

# Test SUM with DISTINCT values
query I
SELECT SUM(DISTINCT amount) FROM sales
----
750

# Test aggregates in window functions with OVER()
query TII rowsort
SELECT region, amount, SUM(amount) OVER () FROM sales
----
North 100 930
North 150 930
North 200 930
South 120 930
South 180 930
South 180 930

# Window function with PARTITION BY would be tested here
# but currently has a bug with pruned output slots

# Create view with aggregates for persistence testing
statement ok
CREATE VIEW region_summary AS 
SELECT region, SUM(amount) as total, COUNT(*) as cnt
FROM sales GROUP BY region

query TII rowsort
SELECT region, total, cnt FROM region_summary
----
North 450 3
South 480 3

# Verify view persists across queries
query I
SELECT SUM(total) FROM region_summary
----
930

statement ok
DROP VIEW region_summary

statement ok
DROP TABLE sales
