query IT rowsort
select id, coalesce(v, 'default') from test_coalesce
----
1 hello
2 world
3 test
4 default

query IT rowsort
select id, coalesce(b, false) from test_coalesce
----
1 true
2 false
3 false
4 true

query T rowsort
select case when b then 'yes' else v end from test_coalesce
----
NULL
hello
world
yes

query T rowsort
select case b when true then 'yes' when false then 'no' else 'unknown' end from test_coalesce
----
no
unknown
yes
yes

