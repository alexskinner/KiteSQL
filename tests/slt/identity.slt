# Identity columns: GENERATED BY DEFAULT AS IDENTITY

statement ok
create table ident_t (id int generated by default as identity primary key, v int)

statement ok
insert into ident_t (v) values (10), (20)

statement ok
insert into ident_t values (null, 30)

query II
select id, v from ident_t order by id
----
1 10
2 20
3 30

# an explicit value moves the counter past it
statement ok
insert into ident_t values (10, 40)

statement ok
insert into ident_t (v) values (50)

# a smaller explicit value leaves it alone
statement ok
insert into ident_t values (5, 60)

statement ok
insert into ident_t (v) values (70), (80)

query II
select id, v from ident_t order by id
----
1 10
2 20
3 30
5 60
10 40
11 50
12 70
13 80

# 0 is stored as given in the generic dialect
statement ok
insert into ident_t values (0, 90)

query I
select id from ident_t where v = 90
----
0

# INSERT ... SELECT generates too
statement ok
insert into ident_t (v) select v + 1 from ident_t where id between 1 and 2

query II
select id, v from ident_t where id > 13 order by id
----
14 11
15 21

# deleted values are not reused
statement ok
delete from ident_t where id >= 14

statement ok
insert into ident_t (v) values (100)

query I
select id from ident_t where v = 100
----
16

# TRUNCATE restarts the counter
statement ok
truncate ident_t

statement ok
insert into ident_t (v) values (1)

query II
select id, v from ident_t
----
1 1

statement ok
drop table ident_t

# START WITH
statement ok
create table ident_s (id bigint generated by default as identity (start with 100) primary key, v int)

statement ok
insert into ident_s (v) values (1), (2)

query II
select id, v from ident_s order by id
----
100 1
101 2

statement ok
drop table ident_s

# a dropped and re-created table starts again at 1
statement ok
create table ident_s (id bigint generated by default as identity primary key, v int)

statement ok
insert into ident_s (v) values (1)

query I
select id from ident_s
----
1

statement ok
drop table ident_s

# the counter stops at the type's maximum, so the next insert fails on the key
statement ok
create table ident_tiny (id tinyint generated by default as identity primary key)

statement ok
insert into ident_tiny values (126)

statement ok
insert into ident_tiny values (null)

statement error
insert into ident_tiny values (null)

query I
select id from ident_tiny order by id
----
126
127

statement ok
drop table ident_tiny

# dropping the identity column removes the identity
statement ok
create table ident_d (k int primary key, id int generated by default as identity)

statement ok
insert into ident_d (k) values (1)

statement ok
alter table ident_d drop column id

statement ok
alter table ident_d add column id int

statement ok
insert into ident_d (k) values (2)

query II
select k, id from ident_d order by k
----
1 NULL
2 NULL

statement ok
drop table ident_d

statement error
create table ident_bad (id varchar(10) generated by default as identity primary key)

statement error
create table ident_bad (id int generated always as identity primary key)

statement error
create table ident_bad (id int generated by default as identity primary key, j int generated by default as identity)

statement error
create table ident_bad (id int generated by default as identity (increment by 2) primary key)

statement ok
create table ident_add (id int primary key)

statement error
alter table ident_add add column j int generated by default as identity

statement ok
drop table ident_add
