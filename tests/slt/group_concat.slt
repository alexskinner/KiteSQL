# group_concat(value [ORDER BY key [ASC|DESC] [NULLS FIRST|LAST], ...] [SEPARATOR 'sep']),
# with DISTINCT on the value. An integer ORDER BY key names a group_concat() argument.

statement ok
create table gc (id int primary key, g int, b varchar(10), n int)

statement ok
insert into gc values (1, 1, 'x', 3), (2, 1, 'y', 1), (3, 1, 'z', 2), (4, 2, 'x', null), (5, 2, null, 5), (6, 2, 'x', 4)

query T
select group_concat(b) from gc
----
x,y,z,x,x

query T
select group_concat(b separator '|') from gc
----
x|y|z|x|x

query T
select group_concat(b separator '') from gc
----
xyzxx

query T
select group_concat(b order by b desc) from gc
----
z,y,x,x,x

query T
select group_concat(b order by n) from gc
----
y,z,x,x,x

query T
select group_concat(b order by n desc, id separator ' ') from gc
----
x x z y x

query T
select group_concat(b order by n nulls first) from gc
----
x,y,z,x,x

query T
select group_concat(b order by 1 separator '#') from gc
----
x#x#x#y#z

query T
select group_concat(distinct b order by b desc) from gc
----
z,y,x

query T
select group_concat(distinct b separator ';') from gc
----
x;y;z

query T
select group_concat(n + 1 order by n desc) from gc
----
6,5,4,3,2

query IT
select g, group_concat(b order by id desc separator '-') from gc group by g order by g
----
1 z-y-x
2 x-x

query T
select group_concat(b order by n) from gc where false
----
NULL

query T
select upper(group_concat(b order by id)) from gc
----
X,Y,Z,X,X

statement ok
create view gc_v as select g, group_concat(b order by id desc separator '/') as s from gc group by g

query IT
select * from gc_v order by g
----
1 z/y/x
2 x/x

statement ok
drop view gc_v

statement error
select group_concat(b order by 2) from gc

statement error
select group_concat(b limit 1) from gc

statement error
select count(b order by b) from gc

statement error
select group_concat(b separator '|') over () from gc

statement ok
drop table gc

# Several values per row are concatenated, as CONCAT() would; a row with any NULL value is skipped.
statement ok
create table gcm (id int primary key, g int, b varchar(10), n int)

statement ok
insert into gcm values (1, 1, 'x', 3), (2, 1, 'y', 1), (3, 1, 'z', 2), (4, 2, 'x', null), (5, 2, null, 5), (6, 2, 'x', 4)

query T
select group_concat(id, '-', b) from gcm
----
1-x,2-y,3-z,4-x,6-x

query T
select group_concat(b, n) from gcm
----
x3,y1,z2,x4

query T
select group_concat(id, b order by 2 desc, 1 separator ' ') from gcm
----
3z 2y 1x 4x 6x

query T
select group_concat(distinct b, g order by b, g separator ';') from gcm
----
x1;x2;y1;z1

query IT
select g, group_concat(b, ':', n order by n desc) from gcm group by g order by g
----
1 x:3,z:2,y:1
2 x:4

query T
select group_concat(b, n) from gcm where false
----
NULL

statement error
select group_concat(b, n order by 3) from gcm

statement error
select group_concat(b, n) over () from gcm

statement ok
drop table gcm
