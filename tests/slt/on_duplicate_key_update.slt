# ON DUPLICATE KEY UPDATE tests for MySQL compatibility

statement ok
DROP TABLE IF EXISTS t

# Test 1: Basic PRIMARY KEY conflict
statement ok
CREATE TABLE t (id INT PRIMARY KEY, value INT)

statement ok
INSERT INTO t VALUES (1, 10)

# 2 affected rows on update
statement ok
INSERT INTO t VALUES (1, 20) ON DUPLICATE KEY UPDATE value = 20

query II rowsort
SELECT * FROM t
----
1 20

# Test 2: Multiple rows with conflicts
statement ok
DROP TABLE IF EXISTS t

statement ok
CREATE TABLE t (id INT PRIMARY KEY, value INT)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

# Insert 3 rows: 1 new (4), 2 conflicts (1,2) - use simple values for now
statement ok
INSERT INTO t VALUES (1, 100), (2, 200), (4, 40) ON DUPLICATE KEY UPDATE value = 999

query II rowsort
SELECT * FROM t
----
1 999
2 999
3 30
4 40

# Test 3: PK conflict with string column
statement ok
DROP TABLE IF EXISTS t

statement ok
CREATE TABLE t (id INT PRIMARY KEY, email VARCHAR(50), value INT)

statement ok
INSERT INTO t VALUES (1, 'test@example.com', 10)

statement ok
INSERT INTO t VALUES (1, 'updated@example.com', 20) ON DUPLICATE KEY UPDATE value = 30, email = 'updated@example.com'

query I
SELECT COUNT(*) FROM t
----
1

query III rowsort
SELECT * FROM t
----
1 updated@example.com 30

