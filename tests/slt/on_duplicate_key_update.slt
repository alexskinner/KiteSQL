# Test 7: Multi-column update on conflict
statement ok
DROP TABLE IF EXISTS t

statement ok
CREATE TABLE t (id INT PRIMARY KEY, a INT, b INT, c INT)

statement ok
INSERT INTO t VALUES (1, 10, 20, 30)

statement ok
INSERT INTO t VALUES (1, 100, 200, 300) ON DUPLICATE KEY UPDATE a = 111, b = 222, c = 333

query IIII
SELECT * FROM t
----
1 111 222 333

# Test 8: Preside-style system config statement
statement ok
DROP TABLE IF EXISTS psys_system_config

statement ok
CREATE TABLE psys_system_config (id VARCHAR(50) PRIMARY KEY, category VARCHAR(50), setting VARCHAR(50), value VARCHAR(50))

statement ok
INSERT INTO psys_system_config (id, category, setting, value) VALUES ('test_id', 'test_cat', 'test_setting', 'false') ON DUPLICATE KEY UPDATE value = 'true'

query CCCC
SELECT * FROM psys_system_config
----
test_id test_cat test_setting false

statement ok
INSERT INTO psys_system_config (id, category, setting, value) VALUES ('test_id', 'test_cat', 'test_setting', 'updated') ON DUPLICATE KEY UPDATE value = 'true'

query CCCC
SELECT * FROM psys_system_config
----
test_id test_cat test_setting true

