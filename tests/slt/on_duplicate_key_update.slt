statement ok
DROP TABLE IF EXISTS t

statement ok
CREATE TABLE t (id INT PRIMARY KEY, value INT)

statement ok
INSERT INTO t VALUES (1, 10) ON DUPLICATE KEY UPDATE value = 20

query II
